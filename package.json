{
  "name": "ai-terminal-assistant",
  "version": "1.0.0",
  "description": "AI-powered terminal assistant desktop application",
  "main": "electron/main.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "dist": "npm run build && electron-builder --win",
    "clean": "rimraf dist && rimraf node_modules/.cache"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "autoprefixer": "^10.4.17",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.8.1",
    "postcss": "^8.4.35",
    "postcss-loader": "^8.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.1",
    "webpack": "^5.106.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "build": {
    "appId": "com.ai.terminalchatbot",
    "productName": "AI & Terminal Chatbot",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "config/**/*",
      "src/plugins/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
